From 7193272db0faba42e6aa93223cd1041ed872949b Mon Sep 17 00:00:00 2001
From: Salvo Giangreco <giangrecosalvo9@gmail.com>
Date: Sat, 24 Oct 2026 19:22:36 +0900
Subject: [PATCH] Backport legacy SehLights HAL code

---
 ...LocalDisplayAdapter$BacklightAdapter.smali | 48 +++++++++++++++++--
 .../lights/LightsService$LightImpl.smali      | 14 ++++--
 .../server/power/PowerManagerUtil.smali       |  2 +
 .../light/ISehLights$Stub$Proxy.smali         |  6 +--
 4 files changed, 59 insertions(+), 11 deletions(-)

diff --git a/smali/com/android/server/display/LocalDisplayAdapter$BacklightAdapter.smali b/smali/com/android/server/display/LocalDisplayAdapter$BacklightAdapter.smali
index 8b8ceec..ae72be0 100644
--- a/smali/com/android/server/display/LocalDisplayAdapter$BacklightAdapter.smali
+++ b/smali/com/android/server/display/LocalDisplayAdapter$BacklightAdapter.smali
@@ -66,14 +66,12 @@
     monitor-enter p0

     :try_start_0
+    move v1, p3
+
     invoke-static {p3}, Landroid/hardware/display/DisplayManagerInternal;->convertBrightnessFloatToInt(F)I

     move-result p1

-    const/16 p2, 0xff
-
-    if-gt p1, p2, :cond_2
-
     and-int/lit16 p1, p1, 0xff

     shl-int/lit8 p2, p1, 0x10
@@ -88,6 +86,48 @@

     or-int/2addr p1, p2

+    iget-object p2, p0, Lcom/android/server/lights/LightsService$LightImpl;->mHwLight:Landroid/hardware/light/HwLight;
+
+    iget-byte p2, p2, Landroid/hardware/light/HwLight;->type:B
+
+    if-eqz p2, :cond_seh_0
+
+    const/16 v0, 0x9
+
+    if-ne p2, v0, :cond_2
+
+    :cond_seh_0
+    const/high16 p2, 0x437f0000    # 255.0f
+
+    mul-float/2addr v1, p2
+
+    sget-boolean p2, Lcom/android/server/power/PowerManagerUtil;->USE_PERSONAL_AUTO_BRIGHTNESS_V3:Z
+
+    if-eqz p2, :cond_seh_1
+
+    const/high16 p2, 0x42c80000    # 100.0f
+
+    mul-float/2addr v1, p2
+
+    :cond_seh_1
+    invoke-static {v1}, Ljava/lang/Math;->round(F)I
+
+    move-result p2
+
+    iput p2, p0, Lcom/android/server/lights/LightsService$LightImpl;->mSehBrightness:I
+
+    const/4 p2, 0x0
+
+    invoke-virtual {p0, p1, p2, p2, p2}, Lcom/android/server/lights/LightsService$LightImpl;->setLightLocked(IIII)V
+
+    const/4 p2, -0x1
+
+    iput p2, p0, Lcom/android/server/lights/LightsService$LightImpl;->mSehBrightness:I
+
+    monitor-exit p0
+
+    return-void
+
     :cond_2
     const/4 p2, 0x0

diff --git a/smali/com/android/server/lights/LightsService$LightImpl.smali b/smali/com/android/server/lights/LightsService$LightImpl.smali
index 0c5459d..bd3def4 100644
--- a/smali/com/android/server/lights/LightsService$LightImpl.smali
+++ b/smali/com/android/server/lights/LightsService$LightImpl.smali
@@ -20,6 +20,8 @@

 .field public mOnMS:I

+.field public mSehBrightness:I
+
 .field public final synthetic this$0:Lcom/android/server/lights/LightsService;


@@ -63,10 +65,14 @@
 .end method

 .method public constructor <init>(Lcom/android/server/lights/LightsService;Landroid/hardware/light/HwLight;)V
-    .locals 0
+    .locals 1

     invoke-direct {p0}, Ljava/lang/Object;-><init>()V

+    const/4 v0, -0x1
+
+    iput v0, p0, Lcom/android/server/lights/LightsService$LightImpl;->mSehBrightness:I
+
     iput-object p1, p0, Lcom/android/server/lights/LightsService$LightImpl;->this$0:Lcom/android/server/lights/LightsService;

     iput-object p2, p0, Lcom/android/server/lights/LightsService$LightImpl;->mHwLight:Landroid/hardware/light/HwLight;
@@ -421,7 +427,9 @@
 .end method

 .method public final setLightUnchecked(IIII)V
-    .locals 5
+    .locals 6
+
+    iget v5, p0, Lcom/android/server/lights/LightsService$LightImpl;->mSehBrightness:I

     const-string/jumbo v0, "LightsService"

@@ -540,7 +548,7 @@

     check-cast p1, Lvendor/samsung/hardware/light/ISehLights$Stub$Proxy;

-    invoke-virtual {p1, p0, v2}, Lvendor/samsung/hardware/light/ISehLights$Stub$Proxy;->setLightState(ILandroid/hardware/light/HwLightState;)V
+    invoke-virtual {p1, p0, v2, v5}, Lvendor/samsung/hardware/light/ISehLights$Stub$Proxy;->setLightState(ILandroid/hardware/light/HwLightState;I)V
     :try_end_0
     .catch Landroid/os/RemoteException; {:try_start_0 .. :try_end_0} :catch_0
     .catch Ljava/lang/UnsupportedOperationException; {:try_start_0 .. :try_end_0} :catch_0

diff --git a/smali_classes2/com/android/server/power/PowerManagerUtil.smali b/smali_classes2/com/android/server/power/PowerManagerUtil.smali
index 5ed710e..1aa36f0 100644
--- a/smali_classes2/com/android/server/power/PowerManagerUtil.smali
+++ b/smali_classes2/com/android/server/power/PowerManagerUtil.smali
@@ -971,6 +971,8 @@
     move v0, v2

     :goto_1d
+    const/4 v0, 0x1
+
     sput-boolean v0, Lcom/android/server/power/PowerManagerUtil;->SEC_FEATURE_USE_LIGHTS_HAL_EXTENSION:Z

     const-string v0, "-1"

diff --git a/smali_classes2/vendor/samsung/hardware/light/ISehLights$Stub$Proxy.smali b/smali_classes2/vendor/samsung/hardware/light/ISehLights$Stub$Proxy.smali
index c88f76f..376be3a 100644
--- a/smali_classes2/vendor/samsung/hardware/light/ISehLights$Stub$Proxy.smali
+++ b/smali_classes2/vendor/samsung/hardware/light/ISehLights$Stub$Proxy.smali
@@ -92,7 +92,7 @@
     throw p0
 .end method

-.method public final setLightState(ILandroid/hardware/light/HwLightState;)V
+.method public final setLightState(ILandroid/hardware/light/HwLightState;I)V
     .locals 3

     iget-object v0, p0, Lvendor/samsung/hardware/light/ISehLights$Stub$Proxy;->mRemote:Landroid/os/IBinder;
@@ -116,9 +116,7 @@

     invoke-virtual {v0, p2, p1}, Landroid/os/Parcel;->writeTypedObject(Landroid/os/Parcelable;I)V

-    const/4 p2, -0x1
-
-    invoke-virtual {v0, p2}, Landroid/os/Parcel;->writeInt(I)V
+    invoke-virtual {v0, p3}, Landroid/os/Parcel;->writeInt(I)V

     iget-object p0, p0, Lvendor/samsung/hardware/light/ISehLights$Stub$Proxy;->mRemote:Landroid/os/IBinder;

