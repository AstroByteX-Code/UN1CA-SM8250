From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: @rezoss_reza <rezoss@local>
Date: Sun, 28 Jun 2026 00:00:00 +0200
Subject: [PATCH] Add Settings background transparency control

Hook the common Settings base activity so the UN1CA Display slider can
apply a dark-mode-only alpha to the Settings window and root backgrounds.

diff --git a/smali_classes3/com/samsung/android/settings/core/SecSettingsBaseActivity.smali b/smali_classes3/com/samsung/android/settings/core/SecSettingsBaseActivity.smali
index 1111111..2222222 100644
--- a/smali_classes3/com/samsung/android/settings/core/SecSettingsBaseActivity.smali
+++ b/smali_classes3/com/samsung/android/settings/core/SecSettingsBaseActivity.smali
@@ -585,6 +585,8 @@

     iput-object p1, p0, Lcom/samsung/android/settings/core/SecSettingsBaseActivity;->mAccessibilityManager:Landroid/view/accessibility/AccessibilityManager;

+    invoke-static {p0}, Lio/mesalabs/unica/settings/display/SettingsBackgroundTransparencyUtils;->apply(Landroid/content/Context;)V
+
     return-void
 .end method

@@ -1380,5 +1382,7 @@
     :catch_0
     :cond_2
+    invoke-static {p0}, Lio/mesalabs/unica/settings/display/SettingsBackgroundTransparencyUtils;->apply(Landroid/content/Context;)V
+
     return-void
 .end method

--
2.43.0
