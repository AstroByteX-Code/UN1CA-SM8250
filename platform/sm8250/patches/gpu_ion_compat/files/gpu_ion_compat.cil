;; MinsOS y2q gpu_ion_compat (generated by ops/oneui9_probe/gen_ion_compat.py, do not edit by hand).
;; Android 16 platform rules on ion_device/gpu_device/sysfs_gpu that Android 17 dropped. base_typeattr sets are copied as
;; minsos_compat_attr_N, with names Android 17 does not declare dropped.
(allow adbd gpu_device (chr_file (ioctl read write getattr lock append map open watch watch_reads)))
(allow adbd gpu_device (dir (ioctl read getattr lock open watch watch_reads search)))
(allow adbd ion_device (chr_file (ioctl read write getattr lock append map open watch watch_reads)))
(typeattribute minsos_compat_attr_3)
(typeattributeset minsos_compat_attr_3 (and (appdomain ) (not (isolated_app_all ))))
(allow minsos_compat_attr_3 gpu_device (chr_file (ioctl read write getattr lock append map open watch watch_reads)))
(typeattribute minsos_compat_attr_4)
(typeattributeset minsos_compat_attr_4 (and (appdomain ) (not (isolated_app_all ))))
(allow minsos_compat_attr_4 gpu_device (dir (ioctl read getattr lock open watch watch_reads search)))
(typeattribute minsos_compat_attr_5)
(typeattributeset minsos_compat_attr_5 (and (appdomain ) (not (isolated_app_all ))))
(allow minsos_compat_attr_5 sysfs_gpu (file (ioctl read getattr lock map open watch watch_reads)))
(typeattribute minsos_compat_attr_6)
(typeattributeset minsos_compat_attr_6 (and (appdomain ) (not (isolated_app_all ))))
(allow minsos_compat_attr_6 ion_device (chr_file (ioctl read getattr lock map open watch watch_reads)))
